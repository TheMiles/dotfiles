# Ghostty configuration
# Docs: https://ghostty.org/docs/config
# All options: ghostty +show-config --default --docs
# Reload: Cmd + Shift + ,

# --- Font ------------------------------------------------------------------
# Ghostty ships with JetBrains Mono and Nerd Font symbols built in.
font-family = JetBrains Mono
font-size = 14
font-thicken = true
adjust-cell-height = 10%

# --- Theme -----------------------------------------------------------------
# Switches automatically with macOS light/dark mode.
# More themes: ghostty +list-themes
theme = light:Catppuccin Latte,dark:Catppuccin Mocha

# --- Window ----------------------------------------------------------------
window-padding-x = 12
window-padding-y = 10
window-padding-balance = true
window-save-state = always
window-theme = auto
macos-titlebar-style = tabs
background-opacity = 0.95
background-blur = 20

# --- Cursor ----------------------------------------------------------------
cursor-style = bar
cursor-style-blink = false
shell-integration-features = no-cursor

# --- Behavior --------------------------------------------------------------
mouse-hide-while-typing = true
copy-on-select = clipboard
confirm-close-surface = false
scrollback-limit = 100000000
macos-option-as-alt = left
quit-after-last-window-closed = false

# --- Quick Terminal (Quake-style dropdown) ---------------------------------
quick-terminal-position = top
quick-terminal-animation-duration = 0.15
keybind = global:ctrl+grave_accent=toggle_quick_terminal
